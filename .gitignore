# Build output
/bin/
/dist/
*.test

# Local collector state — must never be committed: the disk buffer holds
# records, and although redaction runs before the buffer (F-5.3), it is still
# operational data.
/var/
*.parquet
!pkg/record/testdata/**/*.parquet
# The published sample dataset (F-10.5) is data that must ship. Without this
# exception its Parquet files were silently left out of every commit, and the
# committed manifests pointed at files that did not exist.
!spec/testdata/sample-dataset/**/*.parquet

# Editor / OS
.DS_Store
.idea/
.vscode/

# SDK and distribution build output
sdk/typescript/node_modules/
sdk/typescript/dist/
__pycache__/
*.pyc
otelcol/dist/
