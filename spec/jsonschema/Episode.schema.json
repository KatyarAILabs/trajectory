    },
    "group_id": {
      "type": "string"
    },
    "instrumentation": {
      "type": "string"
    },
    "instrumentation_version": {
      "type": "string"
    },
    "raw": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "received_at": {
      "type": [
        "string",
        "integer"
      ]
    },
    "sampled_by": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "started_at": {
      "type": [
        "string",
        "integer"
      ]
    },
    "status": {
      "enum": [
        "STATUS_UNSPECIFIED",
        "STATUS_COMPLETE",
        "STATUS_TIMED_OUT",
        "STATUS_EVICTED",
        "STATUS_PATCHED",
        "complete",
        "timed_out",
        "evicted",
        "patched"
      ],
      "type": "string"
    },
    "step_count": {
      "type": "integer"
    },
    "task_type": {
      "type": "string"
    },
    "tenant": {
      "type": "string"
