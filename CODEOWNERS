/pkg/record/            @trajectory-project/maintainers
/gen/                   @trajectory-project/maintainers

# Redaction, tokenization and the buffer boundary. A mistake here is a data
# leak, not a bug.
/collector/processor/   @trajectory-project/maintainers
/SECURITY.md            @trajectory-project/maintainers
