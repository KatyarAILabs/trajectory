  "additionalProperties": false,
  "properties": {
    "ended_at": {
      "type": [
        "string",
        "integer"
      ]
    },
    "entity_keys": {
      "items": {
        "$ref": "#/$defs/EntityKey"
      },
      "type": "array"
    },
    "episode_id": {
      "type": "string"
    },
    "error": {
      "$ref": "#/$defs/Error"
    },
    "fidelity": {
