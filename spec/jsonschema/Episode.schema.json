        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object"
    },
    "Error": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "type": "object"
    },
    "Fidelity": {
      "additionalProperties": false,
      "properties": {
        "has_params": {
          "type": "boolean"
        },
        "has_token_spans": {
          "type": "boolean"
        },
        "has_tool_versions": {
          "type": "boolean"
        }
      },
      "required": [
        "has_params",
        "has_token_spans",
        "has_tool_versions"
      ],
      "type": "object"
    }
  },
  "$id": "https://trajectory.dev/schema/v0.1.0/Episode.schema.json",
